rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Данные сайта: доступ только у того, кто знает длинный ключ синхронизации
    match /rutina/{key} {
      allow read, write: if request.auth != null && key.size() >= 18;
    }
    // Журнал отправленных напоминаний — только для сервера
    match /rutina_sent/{key} {
      allow read, write: if false;
    }
  }
}
